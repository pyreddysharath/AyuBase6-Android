<?xml version="1.0" encoding="utf-8"?>
<!-- A reminder drawn by the app: the text at full width; "Turn off this" is a crossed bell at the bottom right.
     Closed: Start (Eyes) and the bell sit beside the text. Open: Start and the bell share the last line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/nr_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />
            <TextView android:id="@+id/nr_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="5" android:ellipsize="end" android:textAppearance="@style/TextAppearance.Compat.Notification" />
        </LinearLayout>
        <TextView android:id="@+id/nr_start_side" android:layout_width="wrap_content" android:layout_height="34dp" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="4dp" android:text="▶ Start" android:textStyle="bold" android:visibility="gone" android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />
        <ImageView android:id="@+id/nr_off_side" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="10dp" android:layout_gravity="bottom|end" android:contentDescription="Turn off this reminder" />
    </LinearLayout>
    <LinearLayout android:id="@+id/nr_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp" android:visibility="gone">
        <TextView android:id="@+id/nr_start" android:layout_width="wrap_content" android:layout_height="34dp" android:gravity="center_vertical" android:paddingEnd="16dp" android:text="▶ Start" android:textStyle="bold" android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp" />   <!-- a spacer (a plain View is not allowed in a notification layout: the notification would not show) -->
        <ImageView android:id="@+id/nr_off" android:layout_width="34dp" android:layout_height="34dp" android:contentDescription="Turn off this reminder" />
    </LinearLayout>
</LinearLayout>
