<?xml version="1.0" encoding="utf-8"?>
<!-- The daily Mind thought as a quote: a soft opening mark and the thought in semi-bold italics, no title. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <TextView android:id="@+id/nm_mark" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginEnd="6dp" android:includeFontPadding="false" android:text="“" android:textSize="38sp"
        android:textStyle="bold" android:fontFamily="serif" android:importantForAccessibility="no" />
    <TextView android:id="@+id/nm_text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:maxLines="6" android:ellipsize="end" android:textSize="15sp" android:textStyle="bold|italic" />
</LinearLayout>
