<?xml version="1.0" encoding="utf-8"?>
<!-- The daily Mind thought: the title, then the thought as a quote (a soft opening mark, semi-bold italics). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/nm_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:singleLine="true" android:ellipsize="end" android:text="Mind" android:textStyle="bold" android:textSize="14sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/nm_mark" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="6dp" android:includeFontPadding="false" android:text="“" android:textSize="34sp"
            android:textStyle="bold" android:fontFamily="serif" android:importantForAccessibility="no" />
        <TextView android:id="@+id/nm_text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginTop="1dp" android:maxLines="8" android:ellipsize="end" android:textAppearance="@style/TextAppearance.Compat.Notification" android:textSize="15sp" android:textStyle="bold|italic" />
    </LinearLayout>
</LinearLayout>
